<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Edm\Edm.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="ui\build" />
		<Compile Remove="ui\build\**" />
		<Compile Remove="ui\node_modules\**" />
		<EmbeddedResource Include="ui\build/**" />
		<EmbeddedResource Remove="ui\node_modules\**" />
		<None Remove="ui\build\**" />
		<None Remove="ui\node_modules\**" />
		<None Remove="ui\yarn.lock" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="ui-profile\build" />
		<Compile Remove="ui-profile\build\**" />
		<Compile Remove="ui-profile\node_modules\**" />
		<EmbeddedResource Include="ui-profile\build/**" />
		<EmbeddedResource Remove="ui-profile\node_modules\**" />
		<None Remove="ui-profile\build\**" />
		<None Remove="ui-profile\node_modules\**" />
		<None Remove="ui-profile\package-lock.json" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="ui-driver\build" />
		<Compile Remove="ui-driver\build\**" />
		<Compile Remove="ui-driver\node_modules\**" />
		<EmbeddedResource Include="ui-driver\build/**" />
		<EmbeddedResource Remove="ui-driver\node_modules\**" />
		<None Remove="ui-driver\build\**" />
		<None Remove="ui-driver\node_modules\**" />
		<None Remove="ui-driver\package-lock.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.2.5" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Formatters.Json" Version="2.2.0" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Core" Version="1.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.Json" Version="7.0.0" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="6.0.3" />
	</ItemGroup>

</Project>
