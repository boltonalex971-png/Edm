<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	  <OutputType>Library</OutputType>
	  <LangVersion>14</LangVersion>
	  <!--<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>-->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.377.22" GeneratePathProperty="yes" IncludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edm\Edm.csproj" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="ui-driver\build\**" />
		<Compile Remove="ui-driver\node_modules\**" />
		<EmbeddedResource Include="ui-driver\build/**" />
		<EmbeddedResource Remove="ui-driver\node_modules\**" />
		<None Remove="ui-driver\build\**" />
		<None Remove="ui-driver\node_modules\**" />
		<None Remove="ui-driver\*.local" />
		<None Remove="ui-driver\.env.local" />
		<None Remove="ui-driver\.eslintcache" />
		<None Remove="ui-driver\.gitignore" />
		<None Remove="ui-driver\kendo-ui-license.txt" />
		<None Remove="ui-driver\yarn-error.log" />
		<None Remove="ui-driver\yarn.lock" />
		<None Remove="ui-driver\package-lock.json" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="ui-profile\build/**" />
	</ItemGroup>
	
</Project>
