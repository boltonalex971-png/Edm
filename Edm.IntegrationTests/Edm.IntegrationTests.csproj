<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\EdmAssemblyInfo.cs" Link="Properties\EdmAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optosense.Edm.WebApi\Optosense.Edm.WebApi.csproj" />
    <!-- Build-order only; the plugin is loaded by reflection at runtime, not
         linked into the test assembly. ReferenceOutputAssembly=false stops
         the compiler from seeing the plugin's types. -->
    <ProjectReference Include="..\Optosense.Edm.Drivers.Null\Optosense.Edm.Drivers.Null.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- Stage the Null driver under bin/.../Plugins/Optosense.Edm.Drivers.Null/
       so the host can load it via Edm:Assemblies. The plugin's full bin
       folder is copied so its .deps.json + co-located DLLs are available
       to EdmPluginLoadContext's resolver; framework deps (Microprojects.Edm.*,
       …) are still served by the default ALC. -->
  <Target Name="StageTestPlugins" AfterTargets="Build">
    <ItemGroup>
      <_NullDriverFiles Include="..\Optosense.Edm.Drivers.Null\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_NullDriverFiles)"
          DestinationFiles="@(_NullDriverFiles->'$(OutDir)Plugins\Optosense.Edm.Drivers.Null\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_NullDriverFiles)' != ''" />
  </Target>

</Project>
