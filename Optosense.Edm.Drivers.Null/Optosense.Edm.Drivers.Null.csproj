<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ui\build\**" />
    <Compile Remove="ui\node_modules\**" />
    <EmbeddedResource Remove="ui\node_modules\**" />
    <EmbeddedResource Include="ui\build\**" />
    <None Remove="ui\build\**" />
    <None Remove="ui\node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="ui\.env.local" />
    <None Remove="ui\.eslintcache" />
    <None Remove="ui\.gitignore" />
    <None Remove="ui\yarn-error.log" />
    <None Remove="ui\yarn.lock" />
    <None Remove="ui\*.local" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="6.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optosense.Edm\Optosense.Edm.csproj" />
  </ItemGroup>

</Project>
