{
    "name": "@microprojects/edm-components",
    "version": "0.5.0",
    "type": "module",
    "author": "Microprojects",
    "license": "UNLICENSED",
    "description": "Reusable React UI primitives shared across EDM plugin SPAs (extracted from the Technologies v2 design).",
    "exports": {
        ".":              { "types": "./dist/index.d.ts",      "import": "./dist/index.js" },
        "./components":   { "types": "./dist/components.d.ts", "import": "./dist/components.js" },
        "./iframe":       { "types": "./dist/iframe/index.d.ts", "import": "./dist/iframe/index.js" },
        "./hooks":        { "types": "./dist/hooks.d.ts",      "import": "./dist/hooks.js" },
        "./i18n":         { "types": "./dist/i18n/index.d.ts", "import": "./dist/i18n/index.js" },
        "./styles":       { "types": "./dist/styles.d.ts",     "import": "./dist/styles.js" },
        "./utils":        { "types": "./dist/utils.d.ts",      "import": "./dist/utils.js" },
        "./components/*": { "types": "./dist/components/*.d.ts", "import": "./dist/components/*.js" },
        "./hooks/*":      { "types": "./dist/hooks/*.d.ts",      "import": "./dist/hooks/*.js" },
        "./utils/*":      { "types": "./dist/utils/*.d.ts",      "import": "./dist/utils/*.js" },
        "./styles/*":     { "types": "./dist/styles/*.d.ts",     "import": "./dist/styles/*.js" },
        "./styles/chrome.css": "./dist/styles/chrome.css",
        "./styles/tokens.css": "./dist/styles/tokens.css"
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rslib build",
        "dev":   "rslib build --watch"
    },
    "peerDependencies": {
        "react":               ">=18",
        "react-dom":           ">=18",
        "react-router-dom":    ">=7",
        "@mui/material":       "^7",
        "@mui/icons-material": "^7",
        "@mui/x-data-grid":    "^7 || ^8",
        "@mui/x-tree-view":    "^7 || ^8",
        "@emotion/react":      "^11",
        "@emotion/styled":     "^11",
        "@microsoft/signalr":  "^10",
        "@dnd-kit/core":       "^6",
        "@dnd-kit/modifiers":  "^9",
        "@dnd-kit/utilities":  "^3",
        "axios":               ">=1",
        "i18next":             ">=23",
        "react-i18next":       ">=14",
        "jwt-decode":          ">=4",
        "react-markdown":      ">=9",
        "remark-gfm":          ">=4"
    },
    "peerDependenciesMeta": {
        "@mui/x-data-grid":   { "optional": true },
        "@mui/x-tree-view":   { "optional": true },
        "@microsoft/signalr": { "optional": true },
        "@dnd-kit/core":      { "optional": true },
        "@dnd-kit/modifiers": { "optional": true },
        "@dnd-kit/utilities": { "optional": true },
        "i18next":            { "optional": true },
        "react-i18next":      { "optional": true },
        "jwt-decode":         { "optional": true },
        "react-markdown":     { "optional": true },
        "remark-gfm":         { "optional": true }
    },
    "devDependencies": {
        "@dnd-kit/core":         "^6.3.1",
        "@dnd-kit/modifiers":    "^9.0.0",
        "@dnd-kit/utilities":    "^3.2.2",
        "@emotion/react":        "^11.14.0",
        "@emotion/styled":       "^11.14.1",
        "@microsoft/signalr":    "^10.0.0",
        "@mui/icons-material":   "^7.3.5",
        "@mui/material":         "^7.3.5",
        "@mui/x-data-grid":      "^8.27.3",
        "@mui/x-tree-view":      "^8.27.2",
        "@rsbuild/plugin-react": "^1.4.2",
        "@rsbuild/plugin-sass":  "^1.4.0",
        "@rslib/core":           "^0.18.3",
        "@types/react":          "^18.0.90",
        "@types/react-dom":      "^18.0.26",
        "axios":                 "^1.13.0",
        "i18next":               "^23.16.8",
        "jwt-decode":            "^4.0.0",
        "react":                 "^18.3.1",
        "react-dom":             "^18.3.1",
        "react-i18next":         "^15.4.0",
        "react-markdown":        "^9.0.1",
        "react-router-dom":      "^7.5.0",
        "remark-gfm":            "^4.0.0",
        "sass":                  "^1.77.0",
        "typescript":            "^5.9.3"
    }
}