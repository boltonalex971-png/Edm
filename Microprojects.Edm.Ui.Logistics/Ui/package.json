{
    "name": "logistics",
    "homepage": "/logistics",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "build": "rsbuild build",
        "dev": "rsbuild dev",
        "preview": "rsbuild preview",
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "i18n:coverage": "node tools/check-locale-coverage.mjs",
        "i18n:extract": "i18next 'src/**/*.{ts,tsx}'"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "plugin:i18next/recommended"
        ],
        "rules": {
            "i18next/no-literal-string": [
                "warn",
                {
                    "mode": "jsx-text-only",
                    "message": "Wrap user-visible strings in t() — see docs/specs/multilang-spec.md",
                    "words": {
                        "exclude": [
                            "^\\s*[0-9!-/:-@[-`{-~]+\\s*$",
                            "^\\s*[A-Z_-]+\\s*$"
                        ]
                    }
                }
            ]
        }
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@microprojects/edm-components": "file:../../@microprojects/edm-components",
        "@microprojects/tools": "^1.0.7",
        "@microsoft/signalr": "^10.0.0",
        "@mui/icons-material": "^7.3.5",
        "@mui/material": "^7.3.5",
        "@mui/x-data-grid": "^8.27.3",
        "@mui/x-tree-view": "^8.27.2",
        "@reduxjs/toolkit": "^2.5.1",
        "axios": "^1.7.9",
        "i18next": "^23.16.8",
        "i18next-browser-languagedetector": "^8.0.2",
        "jwt-decode": "^4.0.0",
        "lodash.isequal": "^4.5.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^15.4.0",
        "react-markdown": "^9.0.1",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.5.0",
        "remark-gfm": "^4.0.0",
        "styled-components": "^6.1.16"
    },
    "devDependencies": {
        "@rsbuild/core": "^1.3.4",
        "@rsbuild/plugin-basic-ssl": "^1.2.2",
        "@rsbuild/plugin-eslint": "^1.1.2",
        "@rsbuild/plugin-react": "^1.1.1",
        "@rsbuild/plugin-sass": "^1.3.1",
        "@types/lodash.isequal": "^4.5.8",
        "@types/node": "^22.14.0",
        "@types/react": "^18.3.20",
        "@types/react-dom": "^18.3.6",
        "compression-webpack-plugin": "^12.0.0",
        "eslint": "^8.0.0",
        "eslint-config-react-app": "^7.0.1",
        "eslint-plugin-i18next": "^6.1.4",
        "i18next-parser": "^9.0.2",
        "typescript": "^5.8.3"
    }
}
