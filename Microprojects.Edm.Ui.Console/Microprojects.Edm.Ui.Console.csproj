<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Ui\dist\**" />
    <Compile Remove="Ui\node_modules\**" />
    <EmbeddedResource Include="Ui\dist\**" />
    <EmbeddedResource Remove="Ui\node_modules\**" />
    <EmbeddedResource Include="ABOUT.md" />
    <None Remove="Ui\dist\**" />
    <None Remove="Ui\node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edm\Edm.csproj" />
  </ItemGroup>

</Project>
