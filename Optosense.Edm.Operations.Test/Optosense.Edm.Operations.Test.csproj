<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5</TargetFramework>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ui\build\**" />
    <Compile Remove="ui\node_modules\**" />
    <EmbeddedResource Include="ui\build/**" />
    <EmbeddedResource Remove="ui\node_modules\**" />
    <None Remove="ui\build\**" />
    <None Remove="ui\node_modules\**" />
    <None Remove="ui\*.local" />
    <None Remove="ui\.env.local" />
    <None Remove="ui\.eslintcache" />
    <None Remove="ui\.gitignore" />
    <None Remove="ui\kendo-ui-license.txt" />
    <None Remove="ui\yarn-error.log" />
    <None Remove="ui\yarn.lock" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TypeOneUi\build\**" />
    <Compile Remove="TypeOneUi\node_modules\**" />
    <EmbeddedResource Include="TypeOneUi\build\**" />
    <EmbeddedResource Remove="TypeOneUi\node_modules\**" />
    <None Remove="TypeOneUi\build\**" />
    <None Remove="TypeOneUi\node_modules\**" />
    <None Remove="TypeOneUi\*.local" />
    <None Remove="TypeOneUi\.env.local" />
    <None Remove="TypeOneUi\.eslintcache" />
    <None Remove="TypeOneUi.gitignore" />
    <None Remove="TypeOneUi\kendo-ui-license.txt" />
    <None Remove="TypeOneUi\yarn-error.log" />
    <None Remove="TypeOneUi\yarn.lock" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.2.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Formatters.Json" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edm\Edm.csproj" />
    <ProjectReference Include="..\Optosense.Edm\Optosense.Edm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Pages\" />
  </ItemGroup>

</Project>
