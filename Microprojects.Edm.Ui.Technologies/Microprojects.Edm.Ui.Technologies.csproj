<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
		<LangVersion>14</LangVersion>
		<FileVersion>2.0.0.0</FileVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.2" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.2" />
		<PackageReference Include="UUIDNext" Version="4.2.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Edm\Edm.csproj" />
		<ProjectReference Include="..\Microprojects.Edm.Shared\Microprojects.Edm.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Ui\dist\**" />
	  <Compile Remove="Ui\node_modules\**" />
	  <Content Remove="Ui\dist\**" />
	  <None Remove="Ui\dist\**" />
	  <None Remove="Ui\node_modules\**" />
	  <EmbeddedResource Include="Ui\dist\**" />
	  <EmbeddedResource Remove="Ui\node_modules\**" />
	  <EmbeddedResource Include="CHANGES.md" />
	  <!-- WithCulture=false keeps locale-suffixed markdown in the main assembly;
	       MSBuild otherwise treats `.ru.` as a culture hint and creates a `ru/`
	       satellite assembly the controller can't read from. -->
	  <EmbeddedResource Include="CHANGES.*.md" WithCulture="false" />
	  <EmbeddedResource Include="ABOUT.md" />
	  <EmbeddedResource Include="ABOUT.*.md" WithCulture="false" />
	</ItemGroup>

	<!--
	Stamps the Setup MSI's ProductVersion (from the vdproj) into BuildInfo.g.cs at
	compile time. The vdproj isn't deployed with the host, so the constant is the
	only way the running app can show the installed product's umbrella version.
	-->
	<PropertyGroup>
		<SetupVdprojPath>$(MSBuildThisFileDirectory)..\Optosense.Edm.Setup\Optosense.Edm.Setup.vdproj</SetupVdprojPath>
		<BuildInfoGenerated>$(MSBuildThisFileDirectory)obj\$(Configuration)\$(TargetFramework)\BuildInfo.g.cs</BuildInfoGenerated>
	</PropertyGroup>

	<Target Name="StampSetupProductVersion"
		BeforeTargets="CoreCompile"
		Inputs="$(SetupVdprojPath);$(MSBuildThisFileFullPath)"
		Outputs="$(BuildInfoGenerated)">
		<PropertyGroup>
			<_VdprojText>$([System.IO.File]::ReadAllText('$(SetupVdprojPath)'))</_VdprojText>
			<_ProductVersion>$([System.Text.RegularExpressions.Regex]::Match($(_VdprojText), '"ProductVersion" = "8:([\d.]+)"').Groups[1].Value)</_ProductVersion>
			<_ProductVersion Condition="'$(_ProductVersion)' == ''">0.0.0</_ProductVersion>
		</PropertyGroup>
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<ItemGroup>
			<_BuildInfoLines Include="// &lt;auto-generated /&gt;" />
			<_BuildInfoLines Include="namespace Microprojects.Edm.Ui.Technologies%3B" />
			<_BuildInfoLines Include="internal static class BuildInfo { public const string ProductVersion = &quot;$(_ProductVersion)&quot;%3B }" />
		</ItemGroup>
		<WriteLinesToFile File="$(BuildInfoGenerated)" Lines="@(_BuildInfoLines)" Overwrite="true" Encoding="UTF-8" />
		<ItemGroup>
			<Compile Include="$(BuildInfoGenerated)" />
			<FileWrites Include="$(BuildInfoGenerated)" />
		</ItemGroup>
	</Target>

</Project>
