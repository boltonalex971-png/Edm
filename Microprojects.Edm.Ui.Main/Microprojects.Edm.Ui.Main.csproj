<Project Sdk="Microsoft.NET.Sdk.Web">

	<Target Name="NpmRunBuild" BeforeTargets="Build">
        	<Exec Command="npm run build" WorkingDirectory=".\ClientApp" />
    	</Target>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
		<LangVersion>14</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoMapper" Version="[14.0.0]" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Optosense.Edm.Core.AspNet\Optosense.Edm.Core.AspNet.csproj" />
		<ProjectReference Include="..\Optosense.Edm.Core\Optosense.Edm.Core.csproj" />
		<ProjectReference Include="..\Optosense.Edm.Domain\Optosense.Edm.Domain.csproj" />
		<ProjectReference Include="..\Optosense.Edm.Infrastructure\Optosense.Edm.Infrastructure.csproj" />
		<ProjectReference Include="..\Optosense.Edm\Optosense.Edm.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="ClientApp\build\**" />
	  <Content Remove="ClientApp\build\**" />
	  <None Remove="ClientApp\build\**" />
	  <EmbeddedResource Include="ClientApp\build/**" />
	</ItemGroup>

</Project>
